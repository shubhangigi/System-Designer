PORT=4100
NODE_ENV=development
GENERATION_MODE=ai

# Database
DATABASE_URL=postgresql://archspace:archspace@localhost:5433/archspace

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AI Provider Settings (Default: Local Ollama - Free & Local)
# Options for AI_PROVIDER: 'ollama', 'local', 'openai', 'anthropic', etc.
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=
AI_TIMEOUT_MS=120000
